{
  "name": "filthy-rich",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compress-textures": "node scripts/compress-textures.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "check": "npm run lint && npm run format --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "comlink": "^4.4.1",
    "gsap": "^3.12.5",
    "ktx-parse": "^1.1.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/three": "^0.165.0",
    "basisu": "^1.16.3",
    "canvas": "^3.2.3",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.2.11",
    "vitest": "^2.1.1"
  }
}
